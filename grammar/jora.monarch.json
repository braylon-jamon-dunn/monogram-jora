{
  "defaultToken": "invalid",
  "tokenPostfix": ".jora",
  "ignoreCase": false,
  "brackets": [
    {
      "open": "(",
      "close": ")",
      "token": "delimiter.parenthesis"
    },
    {
      "open": "[",
      "close": "]",
      "token": "delimiter.square"
    },
    {
      "open": "{",
      "close": "}",
      "token": "delimiter.bracket"
    }
  ],
  "tokenizer": {
    "string_dquote_body": [
      [
        "[^\"\\\\]+",
        "string"
      ],
      [
        "\\\\.",
        "string.escape"
      ]
    ],
    "string_dquote": [
      {
        "include": "@string_dquote_body"
      },
      [
        "\"",
        {
          "token": "string",
          "switchTo": "@value"
        }
      ]
    ],
    "string_dquoteN": [
      {
        "include": "@string_dquote_body"
      },
      [
        "\"",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "string_squote_body": [
      [
        "[^'\\\\]+",
        "string"
      ],
      [
        "\\\\.",
        "string.escape"
      ]
    ],
    "string_squote": [
      {
        "include": "@string_squote_body"
      },
      [
        "'",
        {
          "token": "string",
          "switchTo": "@value"
        }
      ]
    ],
    "string_squoteN": [
      {
        "include": "@string_squote_body"
      },
      [
        "'",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "template_body": [
      [
        "\\$\\{",
        {
          "token": "delimiter.bracket",
          "next": "@templateInterp"
        }
      ],
      [
        "[^`\\\\$]+",
        "string"
      ]
    ],
    "template": [
      {
        "include": "@template_body"
      },
      [
        "`",
        {
          "token": "string",
          "switchTo": "@value"
        }
      ],
      [
        ".",
        "string"
      ]
    ],
    "templateN": [
      {
        "include": "@template_body"
      },
      [
        "`",
        {
          "token": "string",
          "next": "@pop"
        }
      ],
      [
        ".",
        "string"
      ]
    ],
    "templateInterp": [
      [
        "[ \\t\\r\\n]+",
        "white"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "/\\*.*$",
        "comment"
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@string_dquoteN"
        }
      ],
      [
        "'",
        {
          "token": "string",
          "next": "@string_squoteN"
        }
      ],
      [
        "`",
        {
          "token": "string",
          "next": "@templateN"
        }
      ],
      [
        "\\{",
        {
          "token": "delimiter.bracket",
          "next": "@bracketCounting"
        }
      ],
      [
        "\\}",
        {
          "token": "delimiter.bracket",
          "next": "@pop"
        }
      ],
      {
        "include": "@interpExprBody"
      }
    ],
    "bracketCounting": [
      [
        "[ \\t\\r\\n]+",
        "white"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "/\\*.*$",
        "comment"
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@string_dquoteN"
        }
      ],
      [
        "'",
        {
          "token": "string",
          "next": "@string_squoteN"
        }
      ],
      [
        "`",
        {
          "token": "string",
          "next": "@templateN"
        }
      ],
      [
        "\\{",
        {
          "token": "delimiter.bracket",
          "next": "@bracketCounting"
        }
      ],
      [
        "\\}",
        {
          "token": "delimiter.bracket",
          "next": "@pop"
        }
      ],
      {
        "include": "@interpExprBody"
      }
    ],
    "exprBody": [
      [
        "[ \\t\\r\\n]+",
        "white"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "/\\*.*$",
        "comment"
      ],
      [
        "\"",
        {
          "token": "string",
          "switchTo": "@string_dquote"
        }
      ],
      [
        "'",
        {
          "token": "string",
          "switchTo": "@string_squote"
        }
      ],
      [
        "`",
        {
          "token": "string",
          "switchTo": "@template"
        }
      ],
      [
        "0[xX][0-9a-fA-F_]+|(?:[0-9_]*\\.)?[0-9_]+(?:[eE][+\\-]?[0-9_]+)?",
        {
          "token": "number",
          "switchTo": "@value"
        }
      ],
      [
        "\\$(?:[a-zA-Z_]|\\\\u[0-9a-fA-F]{4})(?:[a-zA-Z0-9_$]|\\\\u[0-9a-fA-F]{4})*",
        {
          "token": "variable",
          "switchTo": "@value"
        }
      ],
      [
        "\\$\\$",
        {
          "token": "keyword",
          "switchTo": "@value"
        }
      ],
      [
        "\\$",
        {
          "token": "keyword",
          "switchTo": "@value"
        }
      ],
      [
        "@",
        {
          "token": "keyword",
          "switchTo": "@value"
        }
      ],
      [
        "#",
        {
          "token": "keyword",
          "switchTo": "@value"
        }
      ],
      [
        "(?:[a-zA-Z_]|\\\\u[0-9a-fA-F]{4})(?:[a-zA-Z0-9_$]|\\\\u[0-9a-fA-F]{4})*",
        {
          "cases": {
            "true": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "false": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "null": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "undefined": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "NaN": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "Infinity": {
              "token": "keyword",
              "switchTo": "@value"
            },
            "is": {
              "token": "operator",
              "switchTo": "@root"
            },
            "not": {
              "token": "operator",
              "switchTo": "@root"
            },
            "in": {
              "token": "operator",
              "switchTo": "@root"
            },
            "has": {
              "token": "operator",
              "switchTo": "@root"
            },
            "no": {
              "token": "operator",
              "switchTo": "@root"
            },
            "asc": {
              "token": "operator",
              "switchTo": "@root"
            },
            "ascN": {
              "token": "operator",
              "switchTo": "@root"
            },
            "ascA": {
              "token": "operator",
              "switchTo": "@root"
            },
            "ascNA": {
              "token": "operator",
              "switchTo": "@root"
            },
            "ascAN": {
              "token": "operator",
              "switchTo": "@root"
            },
            "desc": {
              "token": "operator",
              "switchTo": "@root"
            },
            "descN": {
              "token": "operator",
              "switchTo": "@root"
            },
            "descA": {
              "token": "operator",
              "switchTo": "@root"
            },
            "descNA": {
              "token": "operator",
              "switchTo": "@root"
            },
            "descAN": {
              "token": "operator",
              "switchTo": "@root"
            },
            "and": {
              "token": "operator",
              "switchTo": "@root"
            },
            "or": {
              "token": "operator",
              "switchTo": "@root"
            },
            "@default": {
              "token": "identifier",
              "switchTo": "@value"
            }
          }
        }
      ],
      [
        "\\)",
        {
          "token": "delimiter.parenthesis",
          "switchTo": "@value"
        }
      ],
      [
        "\\]",
        {
          "token": "delimiter.square",
          "switchTo": "@value"
        }
      ],
      [
        "\\}",
        {
          "token": "delimiter.bracket",
          "switchTo": "@value"
        }
      ],
      [
        "\\.\\.\\.|=>|\\?\\?|!=|~=|<=|>=|\\||=|<|>|\\+|-|\\*|%",
        {
          "token": "operator",
          "switchTo": "@root"
        }
      ],
      [
        "\\(",
        {
          "token": "delimiter.parenthesis",
          "switchTo": "@root"
        }
      ],
      [
        "\\[",
        {
          "token": "delimiter.square",
          "switchTo": "@root"
        }
      ],
      [
        "\\.\\.\\(|\\.\\(|\\.\\[|\\.\\.|:|,|\\.|\\?|;",
        {
          "token": "delimiter",
          "switchTo": "@root"
        }
      ],
      [
        "\\{",
        {
          "token": "delimiter.bracket",
          "switchTo": "@root"
        }
      ]
    ],
    "root": [
      {
        "include": "@exprBody"
      },
      [
        "/(?:\\\\[\\s\\S]|[^/\\n])+/[gimsu]*",
        {
          "token": "regexp",
          "switchTo": "@value"
        }
      ]
    ],
    "value": [
      {
        "include": "@exprBody"
      },
      [
        "/",
        {
          "token": "operator",
          "switchTo": "@root"
        }
      ]
    ],
    "interpExprBody": [
      [
        "0[xX][0-9a-fA-F_]+|(?:[0-9_]*\\.)?[0-9_]+(?:[eE][+\\-]?[0-9_]+)?",
        "number"
      ],
      [
        "\\$(?:[a-zA-Z_]|\\\\u[0-9a-fA-F]{4})(?:[a-zA-Z0-9_$]|\\\\u[0-9a-fA-F]{4})*",
        "variable"
      ],
      [
        "\\$\\$",
        "keyword"
      ],
      [
        "\\$",
        "keyword"
      ],
      [
        "@",
        "keyword"
      ],
      [
        "#",
        "keyword"
      ],
      [
        "(?:[a-zA-Z_]|\\\\u[0-9a-fA-F]{4})(?:[a-zA-Z0-9_$]|\\\\u[0-9a-fA-F]{4})*",
        {
          "cases": {
            "true": "keyword",
            "false": "keyword",
            "null": "keyword",
            "undefined": "keyword",
            "NaN": "keyword",
            "Infinity": "keyword",
            "is": "operator",
            "not": "operator",
            "in": "operator",
            "has": "operator",
            "no": "operator",
            "asc": "operator",
            "ascN": "operator",
            "ascA": "operator",
            "ascNA": "operator",
            "ascAN": "operator",
            "desc": "operator",
            "descN": "operator",
            "descA": "operator",
            "descNA": "operator",
            "descAN": "operator",
            "and": "operator",
            "or": "operator",
            "@default": "identifier"
          }
        }
      ],
      [
        "/(?:\\\\[\\s\\S]|[^/\\n])+/[gimsu]*",
        "regexp"
      ],
      [
        "/",
        "operator"
      ],
      [
        "\\.\\.\\.|=>|\\?\\?|!=|~=|<=|>=|\\||=|<|>|\\+|-|\\*|%",
        "operator"
      ],
      [
        "\\(|\\)",
        "delimiter.parenthesis"
      ],
      [
        "\\[|\\]",
        "delimiter.square"
      ],
      [
        "\\.\\.\\(|\\.\\(|\\.\\[|\\.\\.|:|,|\\.|\\?|;",
        "delimiter"
      ],
      [
        "\\{|\\}",
        "delimiter.bracket"
      ]
    ]
  }
}
