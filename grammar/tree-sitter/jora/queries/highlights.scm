;; -----------------------------------------------------------------
;; Tree-sitter highlight queries generated by monogram.
;; Capture names follow the standard tree-sitter highlight vocabulary
;; (@keyword, @function, @type, @string, @property, @operator, …).
;; Inferred from rule SHAPES + the grammar's `scopes` section — the same
;; structural inference the TextMate generator uses.
;; -----------------------------------------------------------------

;; Bare identifier (lowest priority; specific patterns below win).
(ident) @variable

;; Structural member / type-param / property-access captures.
(property_key (ident) @property)
(expr (expr) (ident) @property)

;; Literal token nodes.
(line_comment) @comment
(block_comment) @comment
(number) @number
(string) @string
(regex_literal) @string.regexp
(template_chars) @string
(variable) @variable
(arg1) @variable.builtin
(current) @variable.builtin
(data) @variable.builtin
(context) @variable.builtin
(template "`") @string
(template_substitution "${") @punctuation.special
(template_substitution "}") @punctuation.special

;; Well-known property names.
((ident) @operator
  (#any-of? @operator ".."))
((ident) @punctuation.delimiter
  (#any-of? @punctuation.delimiter "." "(" "[" ".("))

;; Keyword, operator, and punctuation literals.
[
  "undefined" "Infinity" "false" "true" "null" "NaN"
] @constant.builtin
[
  "descNA" "descAN" "ascNA" "ascAN" "descN" "descA" "ascN" "ascA"
  "desc" "and" "not" "has" "asc" "or" "no" "??"
  "is" "in" "!=" "~=" "<=" ">=" "=>" "="
  "<" ">" "+" "-" "*" "/" "%" "|"
] @operator
[
  "(" ")" "[" "]" "{" "}"
] @punctuation.bracket
[
  "," ":" ";" "?"
] @punctuation.delimiter
